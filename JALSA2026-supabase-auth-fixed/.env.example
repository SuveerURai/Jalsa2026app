# JALSA 2026 Environment Configuration

# Supabase browser/public configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Server-only Supabase secret. NEVER expose this in NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx

# Optional legacy name during Supabase key migration:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Email provider: use brevo for a free Gmail-based sender, or resend with a verified domain
EMAIL_PROVIDER=brevo

# Brevo (recommended for this temporary event setup)
# Create a free Brevo account, add your new Gmail address as a sender, and verify it.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=JALSA 2026

# Optional Resend configuration (requires a verified sending domain for real recipients)
RESEND_API_KEY=
RESEND_FROM_EMAIL=JALSA 2026 <onboarding@resend.dev>

NEXT_PUBLIC_APP_URL=http://localhost:5000
